FROM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392  # pinned digest (rebuilt node:22-slim post disk-corruption)
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 procps && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo
